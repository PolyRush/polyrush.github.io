rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'alexandre.tricot16@gmail.com' && request.auth.token.email_verified == true;
    }
    function banned() {
      return exists(/databases/$(database)/documents/meta/bans)
        && request.auth.uid in get(/databases/$(database)/documents/meta/bans).data.get('uids', []);
    }
    // le pseudo envoyé doit être celui que ce compte a réservé
    function ownsPseudo(p) {
      return p is string && p.size() >= 3 && p.size() <= 16
        && get(/databases/$(database)/documents/pseudos/$(p.lower())).data.uid == request.auth.uid;
    }
    // Un compte ne tient qu'un seul pseudo à la fois : le pseudo de son profil doit être réservé à son nom, et en
    // changer libère l'ancien dans la même opération (sinon on pourrait réserver des dizaines de noms)
    function pseudoDoc(p) { return /databases/$(database)/documents/pseudos/$(p.lower()); }
    function claims(uid, p, old) {
      return p is string && existsAfter(pseudoDoc(p)) && getAfter(pseudoDoc(p)).data.uid == uid
        && (old == '' || old.lower() == p.lower() || !existsAfter(pseudoDoc(old)));
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && (!('pseudo' in request.resource.data) || claims(uid, request.resource.data.pseudo, ''));
      allow update: if request.auth != null && request.auth.uid == uid
        && (request.resource.data.get('pseudo', '') == resource.data.get('pseudo', '')
            || claims(uid, request.resource.data.pseudo, resource.data.get('pseudo', '')));
    }
    match /pseudos/{name} {
      allow read: if true;
      // réservé seulement en le mettant dans son profil en même temps
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'pseudo'])
        && name == request.resource.data.pseudo.lower() && name.matches('^[a-z0-9_.-]{3,16}$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('pseudo', '') == request.resource.data.pseudo;
      // libéré par son propriétaire (en changeant de pseudo), ou retiré par l'admin (pseudo insultant)
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('pseudo', '').lower() != name);
    }
    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // replay d'un temps : envoyé par son auteur seulement, cohérent avec le temps annoncé
    match /ghosts/{level}/runs/{uid} {
      allow read: if isAdmin() || (request.auth != null
        && get(/databases/$(database)/documents/meta/board).data.get('replays', false) == true);
      allow delete: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid && !banned()
        && request.resource.data.keys().hasOnly(['pseudo', 'ms', 't0', 'd', 'v', 'at'])
        && request.resource.data.ms is int && request.resource.data.ms >= 1000 && request.resource.data.ms < 3600000
        && request.resource.data.d is string && request.resource.data.d.size() < 900000
        && request.resource.data.d.size() >= request.resource.data.ms
        && ownsPseudo(request.resource.data.pseudo);
    }
    // un temps n'entre au classement qu'avec son replay (même temps), sous son vrai pseudo, si on n'est pas banni
    match /scores/{level}/runs/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && !banned()
        && request.resource.data.keys().hasOnly(['pseudo', 'ms', 'at', 'ghost'])
        && request.resource.data.ms is int && request.resource.data.ms >= 1000 && request.resource.data.ms < 3600000
        && request.resource.data.ghost == true
        && ownsPseudo(request.resource.data.pseudo)
        && get(/databases/$(database)/documents/ghosts/$(level)/runs/$(uid)).data.ms == request.resource.data.ms;
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }
  }
}
